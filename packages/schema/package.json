{
  "name": "@pcvl/schema",
  "version": "0.0.0",
  "description": "A Zod-style schema-validation library whose schemas can be compiled ahead of time into plain if/for code.",
  "keywords": [
    "validation",
    "schema",
    "standard-schema",
    "typescript",
    "pvl"
  ],
  "homepage": "https://pvl-docs.vercel.app",
  "bugs": "https://github.com/Ota-Prokopec/pvl/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ota-Prokopec/pvl.git",
    "directory": "packages/schema"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@repo/conventions": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "65.0.2",
    "fast-check": "^4.10.1",
    "jiti": "2.7.0",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
