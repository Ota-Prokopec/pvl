{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "docs#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "content/api/**",
        "content/.vitepress/dist/**"
      ]
    },
    "build:thesis": {
      "cache": false,
      "passThroughEnv": [
        "TEXMFHOME",
        "TEXMFLOCAL"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "//#lint:workspace": {
      "cache": false
    },
    "check-types": {
      "dependsOn": [
        "^check-types",
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
