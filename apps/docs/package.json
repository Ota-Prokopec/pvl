{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:api": "typedoc",
    "dev": "run-s docs:api dev:site",
    "dev:site": "vitepress dev content",
    "build": "run-s docs:api build:site",
    "build:site": "vitepress build content",
    "examples:extract": "node scripts/extractDocExamples.ts",
    "lint": "eslint . --max-warnings 0",
    "check-types": "run-s examples:extract check-types:package check-types:examples",
    "check-types:package": "tsc --noEmit",
    "check-types:examples": "tsc --noEmit --project tsconfig.examples.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pvl/schema": "workspace:*",
    "@repo/types": "workspace:^"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^26.4.1",
    "eslint": "10.9.1",
    "npm-run-all": "^4.1.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitepress": "1.6.4",
    "vitest": "^5.0.1"
  }
}
