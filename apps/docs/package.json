{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:api": "typedoc",
    "dev": "run-s docs:api dev:site",
    "dev:site": "vitepress dev content",
    "build": "run-s docs:api build:site",
    "build:site": "vitepress build content",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@pvl/schema": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "10.9.1",
    "npm-run-all": "^4.1.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "vitepress": "1.6.4"
  }
}
